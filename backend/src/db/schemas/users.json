{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "users",
    "description": "Clients, staff and admins. The role decides the portal.",
    "required": ["_id", "email", "password_hash", "role", "status", "created_at", "updated_at"],
    "additionalProperties": false,
    "properties": {
      "_id": { "bsonType": "objectId" },
      "email": {
        "bsonType": "string",
        "maxLength": 254,
        "pattern": "^[^A-Z\\s@]+@[^A-Z\\s@]+\\.[^A-Z\\s@]+$",
        "description": "Trimmed and lowercase, unique (BR-07, TC-004)."
      },
      "password_hash": {
        "bsonType": "string",
        "pattern": "^\\$2[aby]\\$[0-9]{2}\\$[./A-Za-z0-9]{53}$",
        "description": "bcrypt hash, never the password (BR-01, TC-001)."
      },
      "role": { "enum": ["user", "booking_staff", "cleaning_staff", "admin"] },
      "status": {
        "enum": ["active", "terminated"],
        "description": "A terminated user cannot log in."
      },
      "first_name": {
        "bsonType": ["string", "null"],
        "minLength": 1,
        "maxLength": 60,
        "pattern": "\\S",
        "description": "Optional. The API shows first_name + last_name in the header."
      },
      "last_name": {
        "bsonType": ["string", "null"],
        "minLength": 1,
        "maxLength": 80,
        "pattern": "\\S",
        "description": "Optional. One field for every surname."
      },
      "phone": {
        "bsonType": ["object", "null"],
        "description": "Optional. Country code and number go together or not at all.",
        "required": ["country_code", "number"],
        "additionalProperties": false,
        "properties": {
          "country_code": {
            "bsonType": "string",
            "pattern": "^\\+[1-9][0-9]{0,2}$",
            "description": "Plus sign and 1-3 digits, e.g. +52."
          },
          "number": {
            "bsonType": "string",
            "pattern": "^[0-9]{4,14}$",
            "description": "Digits only, without the country code."
          }
        }
      },
      "created_at": { "bsonType": "date" },
      "updated_at": { "bsonType": "date" }
    }
  }
}
