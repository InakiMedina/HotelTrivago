{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "password_reset_tokens",
    "description": "Password reset links (FR-3, BR-06, ST-1). A token is expired when it is issued and expires_at is in the past.",
    "required": ["_id", "user_id", "token_hash", "status", "created_at", "expires_at"],
    "additionalProperties": false,
    "properties": {
      "_id": { "bsonType": "objectId" },
      "user_id": { "bsonType": "objectId" },
      "token_hash": {
        "bsonType": "string",
        "pattern": "^[0-9a-f]{64}$",
        "description": "SHA-256 of the token; the raw token only goes in the email."
      },
      "status": { "enum": ["issued", "used", "superseded"] },
      "created_at": { "bsonType": "date" },
      "expires_at": { "bsonType": "date", "description": "created_at + 10 minutes." },
      "used_at": { "bsonType": ["date", "null"] },
      "superseded_at": { "bsonType": ["date", "null"] }
    },
    "anyOf": [
      { "properties": { "status": { "enum": ["issued"] } } },
      {
        "properties": { "status": { "enum": ["used"] }, "used_at": { "bsonType": "date" } },
        "required": ["used_at"]
      },
      {
        "properties": { "status": { "enum": ["superseded"] }, "superseded_at": { "bsonType": "date" } },
        "required": ["superseded_at"]
      }
    ]
  }
}
